{
  "name": "estreuv",
  "version": "0.2.0",
  "description": "EstreUV.js — micro-Rimwork (Lit class primitive), sister to EstreUI.js. Intent context, lifecycle bridge, Alienese aliases, tiles.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./*.js": {
      "types": "./types/*.d.ts",
      "default": "./src/*.js"
    },
    "./*": {
      "types": "./types/*.d.ts",
      "default": "./src/*"
    }
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "start": "npx http-server . -p 8080 -c-1",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "node scripts/measure-bundle.mjs",
    "measure:d1": "node scripts/measure-d1.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "types": "tsc -p tsconfig.json",
    "prepack": "npm run types"
  },
  "dependencies": {
    "@lit/context": "^1.1.0",
    "lit": "^3.3.0"
  },
  "keywords": [
    "estreui",
    "estreuv",
    "estre",
    "lit",
    "web-components",
    "micro-rimwork",
    "rimwork"
  ],
  "author": "SoliEstre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoliEstre/EstreUV.js.git",
    "directory": "packages/estreuv"
  },
  "homepage": "https://github.com/SoliEstre/EstreUV.js/tree/main/packages/estreuv#readme",
  "bugs": {
    "url": "https://github.com/SoliEstre/EstreUV.js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
