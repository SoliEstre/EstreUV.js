{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "entryPoints": ["../estreuv/src/index.js"],
  "tsconfig": "../estreuv/tsconfig.json",
  "out": "api",
  "name": "estreuv",
  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "sort": ["source-order"],
  "entryFileName": "index",
  "hidePageHeader": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "docsRoot": ".",
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": true
  }
}
